# ========================================
# 실주문 마스터 게이트 (기본 OFF)
# ========================================
LIVE_ORDER_ENABLED=false   # true 는 실환경 검증(PHASE 5) 승인 후에만

# ========================================
# 계좌 프로필 (권장) — legacy / kakao 분리
#   KIS_ACTIVE_PROFILE 로 하나만 활성(런타임 전환 불가, 재시작 필요)
#   legacy 는 MODE 와 무관하게 항상 READ_ONLY(과거자료 조회 전용)
# ========================================
KIS_ACTIVE_PROFILE=legacy            # legacy | kakao

# --- legacy: 기존 계좌 (과거 실거래 자료 조회 전용, 항상 READ_ONLY) ---
KIS_LEGACY_APP_KEY=                  # 기존 계좌 앱키 (로컬만 입력, 커밋 금지)
KIS_LEGACY_APP_SECRET=              # 기존 계좌 시크릿
KIS_LEGACY_ACCOUNT=                 # 기존 계좌번호 8자리
KIS_LEGACY_PRODUCT_CODE=01          # 상품코드(보통 01)
KIS_LEGACY_MODE=READ_ONLY           # 강제 READ_ONLY (변경 무시)

# --- kakao: 신규 카카오뱅크 연계 계좌 (향후 운용) ---
KIS_KAKAO_APP_KEY=                  # 신규 계좌 앱키
KIS_KAKAO_APP_SECRET=              # 신규 계좌 시크릿
KIS_KAKAO_ACCOUNT=                 # 신규 계좌번호 8자리
KIS_KAKAO_PRODUCT_CODE=01
KIS_KAKAO_MODE=READ_ONLY           # READ_ONLY | LIVE (LIVE 는 승인 후에만)

# ========================================
# (하위호환/deprecated) 단일 프로필 — KIS_ACTIVE_PROFILE 미설정 시 'default'(READ_ONLY)
#   신규 설정에서는 위 프로필 변수를 사용하세요.
# ========================================
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678-01
KIS_IS_REAL=false  # true: 실전투자, false: 모의투자

# ========================================
# 텔레그램 알림 설정 (선택사항)
# ========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ========================================
# 매매 기본 설정
# ========================================
MAX_INVESTMENT_PER_STOCK=1000000  # 종목당 최대 투자금액 (원)
MAX_TOTAL_INVESTMENT=5000000      # 총 최대 투자금액 (원)
STOP_LOSS_PERCENT=3.0             # 손절 기준 (%)
TAKE_PROFIT_PERCENT=5.0           # 익절 기준 (%)

# ========================================
# 웹 대시보드 설정
# ========================================
FLASK_SECRET_KEY=your_secret_key_here
DASHBOARD_PORT=5000
